#define BLYNK_TEMPLATE_ID "TMPLxxxxxx"
#define BLYNK_TEMPLATE_NAME "Soil Moisture Monitor"
#define BLYNK_AUTH_TOKEN "YourAuthToken"

#include <ESP8266WiFi.h>
#include <BlynkSimpleEsp8266.h>

char ssid[] = "Nama_WiFi";
char pass[] = "Password_WiFi";

#define SOIL_PIN A0
#define LED_PIN D5

int soilValue;

void setup() {
  Serial.begin(115200);

  pinMode(LED_PIN, OUTPUT);
  digitalWrite(LED_PIN, LOW);

  Blynk.begin(BLYNK_AUTH_TOKEN, ssid, pass);

  Serial.println("Sistem Soil Moisture Aktif");
}

void loop() {
  Blynk.run();

  soilValue = analogRead(SOIL_PIN);

  Serial.print("Nilai Kelembapan Tanah: ");
  Serial.println(soilValue);

  Blynk.virtualWrite(V0, soilValue);

  if (soilValue > 700) {

    Serial.println("Tanah Kering - LED Menyala");

    digitalWrite(LED_PIN, HIGH);

  } else {

    Serial.println("Tanah Lembab - LED Mati");

    digitalWrite(LED_PIN, LOW);
  }

  delay(1000);
}
